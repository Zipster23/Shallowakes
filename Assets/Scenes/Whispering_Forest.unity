--- !u!114 &971168730
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8911529486217002937}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad4a9b616020e1249b78da5a34facf06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 964267458}
  lines:
  - "KO:  \"They marched out of the puddles and left me in the dust \u2014 crinkled,
    brittle, and uninvited.  [E]"
  - 'KO: You can''t march in the Night Parade if you''re too brittle to dance, and
    the God of Storms made sure of that. [E]'
  - 'KO:  "A Hundred Demons... and now there''s only one left to count." [E]'
  - 'KO: "Since you''re wandering into this mess with me, you''d better learn how
    to move."[E]'
  - 'KO: "Walk with [WASD], leap with [Space], sprint with [Shift], dash with [Q]."
    [E]'
  - "KO: \"Glide if you're feeling bold \u2014 [G] For fighting... a slash with [LMB],
    a thrust with [RMB]. [E]"
  - "KO: And if you've got any dignity left \u2014 parry with [F]. I never could.
    No arms, you see.\" [E]"
  - "KO: \"Help me crash their parade \u2014 the one that threw me out \u2014 and
    I'll show you where an old shrine sleeps, forgotten past the treeline.\" [E]"
  - 'KO: "Something rests there. A blade. The kind that doesn''t forgive the hand
    that holds it." [E]'
  textSpeed: 0.02
  icon: {fileID: 92079352}
  bubble: {fileID: 1703677364}
  lightBeam: {fileID: 191723408}
  kasaObakeOnShallo: {fileID: 1721597274}
  kasaObakeDisappearDelay: 2.5
  playerMovement: {fileID: 1581345127}
  playerVFXManager: {fileID: 1581345128}
  dialogueActive: 0
  index: 0
  koColider: {fileID: 0}
